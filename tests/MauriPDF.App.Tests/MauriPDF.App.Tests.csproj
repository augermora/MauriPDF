<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Compile Include="../../src/MauriPDF.App/Presentation/*.cs" Link="Presentation/%(Filename)%(Extension)" />
    <Compile Include="../../src/MauriPDF.App/Printing/*.cs" Link="Printing/%(Filename)%(Extension)" />
    <Compile Include="../../src/MauriPDF.App/WinFormsImageConverter.cs" Link="WinFormsImageConverter.cs" />
    <ProjectReference Include="../../src/MauriPDF.Editing/MauriPDF.Editing.csproj" />
    <ProjectReference Include="../../src/MauriPDF.Rendering/MauriPDF.Rendering.csproj" />
  </ItemGroup>
</Project>
